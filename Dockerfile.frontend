FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

ARG VITE_V34_API_BASE=/backend
ENV VITE_V34_API_BASE=${VITE_V34_API_BASE}
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.v34.conf /etc/nginx/conf.d/default.conf
RUN nginx -t
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

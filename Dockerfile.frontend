FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

ARG VITE_V34_API_BASE=/backend
ENV VITE_V34_API_BASE=${VITE_V34_API_BASE}
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.v34.conf /etc/nginx/conf.d/default.conf
# During image build the Compose DNS name "backend" does not exist yet. Replace it
# only for syntax validation, then restore the real runtime configuration.
RUN cp /etc/nginx/conf.d/default.conf /tmp/default.conf \
    && sed -i 's#http://backend:8787/#http://127.0.0.1:8787/#g' /etc/nginx/conf.d/default.conf \
    && nginx -t \
    && mv /tmp/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# Quantum Commodities R12 — copy locally to .env. Never commit .env.
APP_MODE=PAPER

# R12 stays PAPER unless BOTH APP_MODE=REAL and COMMODITY_ALLOW_REAL=true.
COMMODITY_ALLOW_REAL=false
COMMODITY_MARGIN_PCT=1
COMMODITY_REQUESTED_LEVERAGE=10
COMMODITY_LOOP_MS=5000
COMMODITY_REFRESH_MS=30000
COMMODITY_MAX_HOLD_SECONDS=180
COMMODITY_MIN_EDGE_MULTIPLE=2.5
COMMODITY_MAX_SPREAD_PCT_XAU=0.05
COMMODITY_MAX_SPREAD_PCT_CL=0.08
COMMODITY_TAKER_FEE_PCT_BINANCE=0.05
COMMODITY_TAKER_FEE_PCT_ASTER=0.05
COMMODITY_SLIPPAGE_PCT=0.01

# Aster private credentials are NOT needed for PAPER/public CLUSDT data.
# For a future intentional REAL activation, create an Aster Pro API wallet and put
# these values only in your local .env. Never paste the private key into chat.
ASTER_USER=
ASTER_SIGNER=
ASTER_PRIVATE_KEY=
ASTER_BASE_URL=https://fapi3.asterdex.com

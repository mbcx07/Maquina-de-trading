PORT=8787
APP_MODE=PAPER
DB_PATH=./data/trading-v34.sqlite

# Workspace actual. En plataforma de membresía será reemplazado por el user/workspace autenticado.
DEFAULT_WORKSPACE_ID=default

# Bóveda de secretos
# Producción: usa 32 bytes en base64url o 64 caracteres hex y guárdala en el Secret Manager del hosting.
# Ejemplo para generar una clave: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTEGRATION_MASTER_KEY=
# Solo fallback local si INTEGRATION_MASTER_KEY está vacío. Nunca versionar este archivo.
LOCAL_VAULT_KEY_PATH=./data/.integration-vault-key

# Legacy migration fallback ONLY. Preferir Configuración > Integraciones en la aplicación.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_TESTNET_BASE_URL=https://testnet.binancefuture.com

# Legacy migration fallback ONLY. Preferir Configuración > Integraciones.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MT5 bridge
MT5_BRIDGE_URL=http://127.0.0.1:8790
MT5_BRIDGE_TOKEN=

# Defaults (overridable from persisted settings)
CRYPTO_MAX_TRADES=10
CRYPTO_MARGIN_PCT=1
CRYPTO_REQUESTED_LEVERAGE=20
CRYPTO_MIN_CONFIDENCE=75
CRYPTO_MIN_WINRATE=75
FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD,EURJPY,GBPJPY,EURGBP,EURNZD,GBPNZD
FOREX_MAX_TRADES=20
FOREX_MAX_ENTRIES_PER_SYMBOL=0
FOREX_MIN_CONFIDENCE=75
FOREX_MIN_WINRATE=70
DAILY_LOSS_LIMIT_PCT=5
MAX_DRAWDOWN_PCT=15

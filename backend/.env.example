PORT=8787
APP_MODE=PAPER
DB_PATH=./data/trading-v34.sqlite

DEFAULT_WORKSPACE_ID=default
INTEGRATION_MASTER_KEY=
LOCAL_VAULT_KEY_PATH=./data/.integration-vault-key

# Prefer Configuración > Integraciones. These are only local migration fallbacks.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_TESTNET_BASE_URL=https://testnet.binancefuture.com

# Aster / Binance Wallet leg for CLUSDT. PAPER market data works without private keys.
ASTER_USER=
ASTER_SIGNER=
ASTER_PRIVATE_KEY=
ASTER_BASE_URL=https://fapi3.asterdex.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MT5 bridge
MT5_BRIDGE_URL=http://127.0.0.1:8790
MT5_BRIDGE_TOKEN=

# R15 Dual Commodities
COMMODITY_PAPER_INITIAL_BALANCE=50
COMMODITY_MARGIN_PCT=1
COMMODITY_REQUESTED_LEVERAGE=125
COMMODITY_LOOP_MS=1000
COMMODITY_MARKET_REFRESH_MS=2000
COMMODITY_STREAM_MS=500
COMMODITY_MAX_HOLD_SECONDS=180
COMMODITY_SIGNAL_SCORE_MIN=58
COMMODITY_MIN_EDGE_MULTIPLE=2.2
COMMODITY_MAX_SPREAD_PCT_XAU=0.05
COMMODITY_MAX_SPREAD_PCT_CL=0.08
COMMODITY_TAKER_FEE_PCT_BINANCE=0.05
COMMODITY_TAKER_FEE_PCT_ASTER=0.05
COMMODITY_SLIPPAGE_PCT=0.01
COMMODITY_BACKTEST_MAX_DAYS=365
COMMODITY_ALLOW_REAL=false

# Legacy compatibility only; R15 uses COMMODITY_MARKET_REFRESH_MS.
COMMODITY_REFRESH_MS=30000

# MT5 comparison leg
MT5_COMMODITY_MAX_SPREAD_PCT_XAU=0.08
MT5_COMMODITY_MAX_SPREAD_PCT_CL=0.12
MT5_COMMODITY_COMMISSION_PCT=0
MT5_COMMODITY_SLIPPAGE_PCT=0.005

# Legacy engine settings retained for schema compatibility.
CRYPTO_MAX_TRADES=10
CRYPTO_MARGIN_PCT=1
CRYPTO_REQUESTED_LEVERAGE=20
CRYPTO_MIN_CONFIDENCE=70
CRYPTO_MIN_WINRATE=64
FOREX_SYMBOLS=XAUUSD
FOREX_MIN_CONFIDENCE=70
FOREX_MIN_WINRATE=64
DAILY_LOSS_LIMIT_PCT=5
MAX_DRAWDOWN_PCT=15
